# Copy this file to  .env  (same folder) and edit. .env is git-ignored, never commit real secrets.

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Default = SQLite file backend/complaints.db (nothing to install). To use PostgreSQL instead, run
#   docker compose up -d      (see docker-compose.yml)  and uncomment the next line:
# DATABASE_URL=postgresql+psycopg2://complaints:complaints@localhost:5432/complaints
